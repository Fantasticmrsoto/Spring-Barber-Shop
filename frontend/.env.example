# URL base del backend (src/api/client.js)
#
# Opcional: si no se define, la web deduce sola la URL de la API a partir del
# host con el que se sirvio (http://<host>:3000). Asi la app funciona en el PC
# (localhost) y en el movil (IP de la red local) sin tocar nada, incluso si la
# IP del equipo cambia.
#
# Descomenta y ajusta solo si necesitas apuntar a otro backend:
# VITE_API_URL=http://192.168.0.251:3000
