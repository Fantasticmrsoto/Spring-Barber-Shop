# Puerto del servidor. En la nube lo fija la plataforma (Render usa 10000 por
# defecto); en local se usa 3000.
PORT=3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Opción 1 (local): PostgreSQL instalado en el equipo.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=barberia
DB_PASSWORD=cambiar_esto
DB_PORT=5432

# Opción 2 (nube): una sola URL de conexión. Tiene prioridad sobre las
# variables de arriba. Es lo que entregan Neon, Supabase, Railway o Render:
#
#   DATABASE_URL=postgresql://usuario:clave@host.neon.tech:5432/barberia?sslmode=require
#
# DATABASE_URL=
# Las bases de datos gestionadas exigen SSL. Si la URL no incluye
# `sslmode=require`, actívalo aquí:
# DB_SSL=true
# Conexiones máximas del pool. Los proveedores gestionados suelen permitir
# pocas conexiones por proceso:
# DB_POOL_MAX=5

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Secreto para firmar los JWT. Obligatorio: la aplicación no arranca sin él.
# En producción usa un valor aleatorio largo, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto

# Orígenes permitidos por CORS, separados por comas. Déjalo vacío para
# permitir cualquier origen (solo en desarrollo). En producción con la web y
# la API en dominios distintos:
# CORS_ORIGIN=https://springbarbershop.com,https://www.springbarbershop.com

# Cuántos proxies hay delante de la app. Con 1 (Render, nginx, Cloudflare) se
# toma la IP real del cliente desde X-Forwarded-For, que es lo que necesita el
# limitador de intentos de login. En local: false.
TRUST_PROXY=false

# Entorno: production activa el cierre ordenado y los ajustes de despliegue.
NODE_ENV=development

# Servir la web compilada (frontend/dist) desde este mismo proceso, para
# desplegar web y API en un único servicio bajo el mismo dominio. En
# producción se activa solo; ponlo en false para desactivarlo.
# SERVE_FRONTEND=true

# Aplicar las migraciones automáticamente al arrancar si la base de datos no
# tiene el esquema. Es lo que evita que un despliegue nuevo salga con la web
# cargada pero todas las secciones de datos en error. Ponlo en false solo si
# el usuario de la base de datos no tiene permiso para crear tablas.
# AUTO_MIGRATE=true

# Contraseñas del script de datos iniciales (npm run seed). Si no se
# definen, se usan las de ejemplo, que solo valen para desarrollo.
# SEED_ADMIN_PASSWORD=
# SEED_BARBERO_PASSWORD=
# SEED_CLIENTE_PASSWORD=

# Ruta a la build de la web, si se sirve desde el mismo proceso (opcional).
# FRONTEND_DIST=/app/frontend/dist
